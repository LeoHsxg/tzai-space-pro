rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /bookings/{bookingId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
